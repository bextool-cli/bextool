{
  "name": "bextool",
  "version": "2.0.2",
  "description": "CLI for scaffolding apps, extensions, services, CLIs, and developer tooling",
  "bin": {
    "bextool": "src/index.js"
  },
  "keywords": [
    "cli",
    "scaffolding",
    "starter",
    "templates",
    "browser-extension",
    "react",
    "express",
    "electron"
  ],
  "homepage": "https://www.bextool.tech/",
  "bugs": {
    "url": "https://github.com/bextool-cli/bextool/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bextool-cli/bextool.git"
  },
  "license": "ISC",
  "author": "Abhiraj (GitHub: Abhiraj35)",
  "contributors": [
    "Shubham Raj (GitHub: Shubham-1068)"
  ],
  "type": "module",
  "main": "./src/index.js",
  "files": [
    "src",
    "templates",
    "public",
    "README.md",
    "LICENSE"
  ],
  "preferGlobal": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "check": "node scripts/check.js",
    "smoke": "node scripts/smoke-test.js",
    "test": "npm run check && npm run smoke",
    "start": "node src/index.js",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "chalk": "^5.6.2",
    "execa": "^8.0.1",
    "fs-extra": "^11.2.0",
    "handlebars": "^4.7.8",
    "kleur": "^4.1.5"
  }
}
