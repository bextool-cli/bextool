:root {
  font-family: "Segoe UI", sans-serif;
  color: #1f2937;
  background: linear-gradient(135deg, #fff7ed, #ffedd5);
}

body {
  margin: 0;
  min-height: 100vh;
}

.app-shell {
  max-width: 48rem;
  margin: 0 auto;
  padding: 6rem 1.5rem;
  text-align: center;
}

.eyebrow {
  text-transform: uppercase;
  letter-spacing: 0.15em;
  color: #c2410c;
}

.description {
  color: #4b5563;
  margin-bottom: 2rem;
}

button {
  border: 0;
  border-radius: 999px;
  padding: 0.85rem 1.4rem;
  background: #ea580c;
  color: white;
  font-size: 1rem;
  cursor: pointer;
}
