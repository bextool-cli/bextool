html,
body {
  padding: 0;
  margin: 0;
  font-family: "Segoe UI", sans-serif;
  background: #fff7ed;
  color: #1f2937;
}

* {
  box-sizing: border-box;
}

.page-shell {
  padding: 4rem 1.5rem;
  max-width: 52rem;
}

.eyebrow {
  text-transform: uppercase;
  letter-spacing: 0.15em;
  color: #c2410c;
}
